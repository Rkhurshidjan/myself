# @BotFather dan olingan token (majburiy)
BOT_TOKEN=123456:ABC-your-token

# Adminlarning Telegram ID lari, vergul bilan (botga /myid yozib bilib olasiz)
ADMIN_IDS=111111111,222222222

# Ixtiyoriy: tabrik yuboriladigan guruh ID lari (yoki guruhda /subscribe)
CHAT_IDS=

# Kunlik tekshiruv vaqti va vaqt zonasi
NOTIFY_TIME=09:00
TZ_NAME=Asia/Tashkent

# Necha kun oldin adminlarga eslatish
REMIND_DAYS=3,1

# --- Ovozli yordamchi (ikkalasi bo'lsa yoqiladi) ---
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# console.groq.com -> API Keys (bepul; nutqni matnga aylantirish uchun)
GROQ_API_KEY=
# Kim foydalana oladi: bo'sh = faqat adminlar, "*" = hamma, yoki ID lar vergul bilan
ASSISTANT_USERS=
# Ovoz (bepul Edge TTS): uz-UZ-SardorNeural (erkak) yoki uz-UZ-MadinaNeural (ayol)
TTS_VOICE=uz-UZ-SardorNeural
# Nutq tili: uz, ru, en ... Bo'sh qoldirsangiz avtomatik aniqlanadi
STT_LANGUAGE=uz
# 0 qilsangiz faqat matn bilan javob beradi
VOICE_REPLY=1

# Railway Postgres qo'shsangiz avtomatik keladi: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
